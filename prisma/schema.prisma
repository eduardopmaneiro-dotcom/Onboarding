// ════════════════════════════════════════════════════════════════════════════
// Plataforma de RH — Riale Hotéis
// Fase 1: fundação (identidade, permissões, estrutura organizacional, segurança)
// Tabelas de recrutamento/admissão já preparadas para a Fase 2.
// Modelos de onboarding/carreira/PDI preservados do MVP anterior.
// Convenção: dados pessoais sensíveis (CPF) NUNCA em texto puro —
//   *Hash   = HMAC-SHA256 com pepper (busca/unicidade)
//   *Enc    = AES-256-GCM (exibição restrita, sempre auditada)
// ════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon: conexão com pool (-pooler)
  directUrl = env("DATABASE_URL_UNPOOLED") // Neon: conexão direta (migrações)
}

// ───────────────────────── IDENTIDADE E ACESSO ─────────────────────────

enum Role {
  ADMIN // Administrador do sistema
  RH // Equipe de Recursos Humanos (corporativo ou de unidade)
  GESTOR // Gestor de área/departamento
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  cpfHash            String    @unique // HMAC — login e unicidade
  cpfEnc             String // AES-GCM — exibição restrita
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  /// RH de unidade fica limitado à unidade; nulo = corporativo (todas)
  unitId             String?
  unit               Unit?     @relation(fields: [unitId], references: [id])
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]    @relation("UserCreatedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager                 Manager?
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]           @relation("ActorUser")
  notifications           Notification[]
  documentsUploaded       Document[]
  settingsUpdated         Setting[]
  movementsRecorded       MovementHistory[]
  interviewsAsInterviewer Interview[]          @relation("InterviewInterviewer")
  interviewResults        Interview[]          @relation("InterviewResultBy")
  reviewsRequested        ManagerReview[]      @relation("ReviewRequestedBy")
  reviewsDecided          ManagerReview[]      @relation("ReviewDecidedBy")
  candidateEvents         CandidateEvent[]     @relation("CandidateEventActor")
  importBatches           ImportBatch[]        @relation("ImportCreatedBy")

  @@index([role])
  @@index([unitId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique // ex.: "org.manage"
  module      String // ex.: "estrutura", "usuarios"
  description String
  roles       RolePermission[]
}

model RolePermission {
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([role, permissionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 do token; o token em claro só existe no e-mail
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────── ESTRUTURA ORGANIZACIONAL ─────────────────────────

model Unit {
  // Brisa Barra, Imperial, Vilamar (+ futuras unidades)
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  city      String?
  state     String?  @db.Char(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  users       User[]
}

model Department {
  id            String            @id @default(cuid())
  name          String
  code          String?
  unitId        String
  unit          Unit              @relation(fields: [unitId], references: [id])
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  employees     Employee[]
  jobOpenings   JobOpening[]
  movementsFrom MovementHistory[] @relation("MovementFromDept")
  movementsTo   MovementHistory[] @relation("MovementToDept")
  managers      Manager[] // mais de um gestor por departamento é permitido

  @@unique([unitId, name])
  @@index([unitId])
}

enum CareerLevel {
  N1
  N2
  N3
  N4
  N5
  N6
  N7
}

model CareerTrack {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  active      Boolean @default(true)

  positions Position[]
  stages    CareerStage[]
}

model Position {
  // Cargo: catálogo corporativo único (comparável entre unidades — base para remuneração e carreira).
  // Onde a pessoa trabalha é dado pelo Departamento (que pertence a uma Unidade).
  id                    String               @id @default(cuid())
  title                 String
  code                  String?              @unique // CBO ou código interno
  level                 CareerLevel
  description           String?              @db.Text
  careerTrackId         String?
  careerTrack           CareerTrack?         @relation(fields: [careerTrackId], references: [id])
  isLeadership          Boolean              @default(false)
  /// Área padrão do cargo (nome do departamento) — usada para sugerir o departamento na vaga
  defaultDepartmentName String?
  /// Outras grafias do cargo (aprendidas na importação: "Ass. Governança", "garçom"…)
  aliases               String[]             @default([])
  active                Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  employees             Employee[]
  desiredByCandidates   Candidate[]          @relation("CandidateDesiredPosition")
  jobOpenings           JobOpening[]
  onboardingTemplates   OnboardingTemplate[]
  pdlCandidacies        PDLCandidacy[]
  movementsFrom         MovementHistory[]    @relation("MovementFrom")
  movementsTo           MovementHistory[]    @relation("MovementTo")
  managers              Manager[]

  @@unique([title])
}

model CareerStage {
  id              String      @id @default(cuid())
  careerTrackId   String
  careerTrack     CareerTrack @relation(fields: [careerTrackId], references: [id])
  level           CareerLevel
  typicalMonths   String?
  masteryCriteria String      @db.Text
  order           Int

  requirements StageRequirement[]

  @@unique([careerTrackId, level])
}

enum RequirementType {
  TRAINING
  COMPETENCY
  METRIC
  DISCIPLINARY
  OTHER
}

model StageRequirement {
  id            String          @id @default(cuid())
  careerStageId String
  careerStage   CareerStage     @relation(fields: [careerStageId], references: [id])
  type          RequirementType
  description   String
  targetValue   String?
}

/// Gestor: cadastro próprio (nem todo gestor precisa ter login).
/// Identificação por CPF (protegido) e/ou matrícula interna — ao menos um é obrigatório (validado na aplicação).
/// O e-mail será usado pelas comunicações automáticas (tabela Notification).
model Manager {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  cpfHash          String?    @unique
  cpfEnc           String?
  internalId       String?    @unique // matrícula
  positionId       String
  position         Position   @relation(fields: [positionId], references: [id])
  departmentId     String // departamento gerido (a unidade é derivada do departamento)
  department       Department @relation(fields: [departmentId], references: [id])
  /// Superior direto (outro gestor) — hierarquia auto-relacionada
  directSuperiorId String?
  directSuperior   Manager?   @relation("ManagerHierarchy", fields: [directSuperiorId], references: [id])
  directReports    Manager[]  @relation("ManagerHierarchy")
  /// Login opcional (perfil GESTOR)
  userId           String?    @unique
  user             User?      @relation(fields: [userId], references: [id])
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employees      Employee[]
  jobOpenings    JobOpening[]
  managerReviews ManagerReview[]
  movementsFrom  MovementHistory[] @relation("MovementFromManager")
  movementsTo    MovementHistory[] @relation("MovementToManager")
  ManagerDigest  ManagerDigest[]

  @@index([departmentId])
}

// ───────────────────────── COLABORADORES ─────────────────────────

enum EmployeeStatus {
  PRE_ADMISSAO
  EM_ONBOARDING
  ATIVO
  PERIODO_ESTENDIDO
  AFASTADO
  DESLIGADO
}

enum ContractType {
  CLT
  PJ
  ESTAGIO
  TEMPORARIO
}

model Employee {
  id              String         @id @default(cuid())
  fullName        String
  internalId      String?        @unique // matrícula
  cpfHash         String?        @unique
  cpfEnc          String?
  email           String?
  contractType    ContractType   @default(CLT)
  departmentId    String // departamento → unidade (sem duplicar a unidade)
  department      Department     @relation(fields: [departmentId], references: [id])
  positionId      String
  position        Position       @relation(fields: [positionId], references: [id])
  managerId       String?
  manager         Manager?       @relation(fields: [managerId], references: [id])
  buddyId         String?
  buddy           Employee?      @relation("BuddyEmployees", fields: [buddyId], references: [id])
  buddyFor        Employee[]     @relation("BuddyEmployees")
  status          EmployeeStatus @default(PRE_ADMISSAO)
  admissionDate   DateTime
  terminationDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  movements       MovementHistory[]
  candidateOrigin Candidate?
  onboardings     OnboardingProcess[]
  pdis            PDI[]
  promotionScores PromotionScore[]
  pdlCandidacies  PDLCandidacy[]
  auditImpacted   AuditLog[]          @relation("ImpactedEmployee")

  responsibleStages       OnboardingStage[]
  checklistItems          ChecklistItem[]
  checklistResponsibleFor ChecklistItem[]   @relation("ChecklistResponsible")
  checklistCompletedFor   ChecklistItem[]   @relation("ChecklistCompletedBy")
  checklistValidatedFor   ChecklistItem[]   @relation("ChecklistValidatedBy")
  pdiExecutorFor          PDI[]             @relation("PDIExecutor")
  pdiMonitorFor           PDI[]             @relation("PDIMonitor")
  evaluationsGiven        Evaluation[]

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([status])
}

enum MovementType {
  ADMISSAO
  PROMOCAO
  TRANSFERENCIA_UNIDADE
  TRANSFERENCIA_DEPARTAMENTO
  MUDANCA_CARGO
  ALTERACAO_SALARIAL
  MUDANCA_GESTOR
  AFASTAMENTO
  RETORNO
  DESLIGAMENTO
}

/// Histórico de movimentações — imutável (somente inserção). Referencia cargo, departamento e gestor
/// por chave (a unidade deriva do departamento), preservando a história mesmo com renomeações.
model MovementHistory {
  id               String       @id @default(cuid())
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id])
  type             MovementType
  effectiveDate    DateTime
  fromPositionId   String?
  fromPosition     Position?    @relation("MovementFrom", fields: [fromPositionId], references: [id])
  toPositionId     String?
  toPosition       Position?    @relation("MovementTo", fields: [toPositionId], references: [id])
  fromDepartmentId String?
  fromDepartment   Department?  @relation("MovementFromDept", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String?
  toDepartment     Department?  @relation("MovementToDept", fields: [toDepartmentId], references: [id])
  fromManagerId    String?
  fromManager      Manager?     @relation("MovementFromManager", fields: [fromManagerId], references: [id])
  toManagerId      String?
  toManager        Manager?     @relation("MovementToManager", fields: [toManagerId], references: [id])
  /// Valores salariais ficam em módulo próprio (Remuneração, Fase futura) com acesso mais restrito
  reason           String?      @db.Text
  recordedById     String
  recordedBy       User         @relation(fields: [recordedById], references: [id])
  createdAt        DateTime     @default(now())

  @@index([employeeId, effectiveDate])
}

// ───────────────────────── RECRUTAMENTO E SELEÇÃO (Fase 2) ─────────────────────────

enum JobOpeningStatus {
  RASCUNHO
  AGUARDANDO_APROVACAO
  ABERTA
  PAUSADA
  PREENCHIDA
  CANCELADA
  ENCERRADA // vagas históricas (importação) ou encerradas sem preenchimento
}

enum JobOpeningReason {
  AUMENTO_QUADRO
  SUBSTITUICAO
  TEMPORARIA
}

/// Escala de trabalho (hotelaria)
enum WorkSchedule {
  SEIS_POR_UM
  CINCO_POR_DOIS
  DOZE_POR_TRINTA_E_SEIS
  OUTRA
}

/// Turno (RH-ONB-03: Diurno · Noturno · 12x36 · Administrativo)
enum WorkShift {
  DIURNO
  NOTURNO
  MISTO
  ADMINISTRATIVO
}

model JobOpening {
  id                  String           @id @default(cuid())
  code                String           @unique // VAG-2026-0001 (sequência no banco)
  positionId          String
  position            Position         @relation(fields: [positionId], references: [id])
  departmentId        String // departamento → unidade
  department          Department       @relation(fields: [departmentId], references: [id])
  /// Gestor responsável — vem da estrutura organizacional
  requestingManagerId String?
  requestingManager   Manager?         @relation(fields: [requestingManagerId], references: [id])
  reason              JobOpeningReason @default(SUBSTITUICAO)
  headcount           Int              @default(1)
  status              JobOpeningStatus @default(ABERTA)
  contractType        ContractType     @default(CLT)
  expectedSalary      Decimal?         @db.Decimal(10, 2) // salário previsto
  schedule            WorkSchedule?
  shift               WorkShift?
  weeklyHours         Int? // jornada semanal (ex.: 44)
  workHours           String? // horário (ex.: 07:00–15:20)
  description         String?          @db.Text
  requirements        String?          @db.Text
  openedAt            DateTime?
  closedAt            DateTime?
  targetDate          DateTime?
  isHistorical        Boolean          @default(false) // criada pela importação da planilha
  importBatchId       String?
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  applications Application[]

  @@index([status])
  @@index([positionId])
  @@index([departmentId])
}

enum CandidateSource {
  INDICACAO
  SITE
  LINKEDIN
  INDEED
  AGENCIA
  BANCO_TALENTOS
  INSTAGRAM
  WHATSAPP
  SINE
  PRESENCIAL
  EX_COLABORADOR
  OUTRO
}

/// Candidato — cadastro mínimo (LGPD: sem CPF/endereço nesta etapa).
/// nameNormalized/phoneNormalized servem à verificação de duplicidade.
model Candidate {
  id                String          @id @default(cuid())
  fullName          String
  nameNormalized    String          @default("")
  email             String?
  phone             String?
  phoneNormalized   String?
  desiredPositionId String? // cargo pretendido (preenchido pela vaga quando houver)
  desiredPosition   Position?       @relation("CandidateDesiredPosition", fields: [desiredPositionId], references: [id])
  notes             String?         @db.Text
  cpfHash           String?         @unique
  cpfEnc            String?
  source            CandidateSource @default(OUTRO)
  consentAt         DateTime? // aceite do aviso de privacidade
  consentVersion    String?
  retainUntil       DateTime? // após esta data: anonimização
  anonymizedAt      DateTime?
  hiredEmployeeId   String?         @unique
  hiredEmployee     Employee?       @relation(fields: [hiredEmployeeId], references: [id])
  importBatchId     String?
  createdById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  applications Application[]
  events       CandidateEvent[]

  @@index([email])
  @@index([nameNormalized])
  @@index([phoneNormalized])
}

enum ApplicationStatus {
  TRIAGEM
  ENTREVISTA
  AVALIACAO // aguardando avaliação externa (ex.: AGINCO / sindicância)
  AGUARDANDO_GESTOR
  PROPOSTA
  APROVADO
  REPROVADO
  DESISTENTE
  NAO_COMPARECEU
  BANCO_TALENTOS
  CONTRATADO
}

/// Avaliação externa entre RH e gestor (na planilha atual: AGINCO / sindicância)
enum ExternalCheckStatus {
  NAO_APLICA
  AGUARDANDO
  APROVADO
  REPROVADO
}

/// Candidatura: candidato × vaga. Guarda a negociação salarial (base da inteligência de mercado).
model Application {
  id                  String              @id @default(cuid())
  candidateId         String
  candidate           Candidate           @relation(fields: [candidateId], references: [id])
  jobOpeningId        String
  jobOpening          JobOpening          @relation(fields: [jobOpeningId], references: [id])
  status              ApplicationStatus   @default(TRIAGEM)
  offeredSalary       Decimal?            @db.Decimal(10, 2)
  expectedSalary      Decimal?            @db.Decimal(10, 2) // pretensão
  lastSalary          Decimal?            @db.Decimal(10, 2)
  valuedBenefits      String[]            @default([])
  externalCheckStatus ExternalCheckStatus @default(NAO_APLICA)
  externalCheckNote   String?
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  interviews     Interview[]
  managerReviews ManagerReview[]
  events         CandidateEvent[]

  @@unique([candidateId, jobOpeningId])
  @@index([jobOpeningId, status])
}

enum InterviewType {
  TRIAGEM_RH
  TECNICA
  GESTOR
  FINAL
}

enum InterviewStatus {
  AGENDADA
  REALIZADA
  CANCELADA
  NAO_COMPARECEU
}

/// Resultado do RH na entrevista (separado da decisão do gestor — ManagerReview)
enum InterviewResult {
  PENDENTE
  APROVADO
  REPROVADO
  NAO_COMPARECEU
  DESISTIU
}

/// Motivos padronizados (editáveis em Configurações); `code` estável para análises.
model RejectionReason {
  id           String   @id @default(cuid())
  code         String   @unique
  label        String
  requiresNote Boolean  @default(false) // "Outro" exige observação
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  interviews Interview[]
  reviews    ManagerReview[]
}

model Interview {
  id                String           @id @default(cuid())
  applicationId     String
  application       Application      @relation(fields: [applicationId], references: [id])
  type              InterviewType    @default(TRIAGEM_RH)
  stage             Int              @default(1) // 1ª, 2ª etapa…
  scheduledAt       DateTime
  hasTime           Boolean          @default(true) // falso em registros importados só com data
  durationMin       Int              @default(30)
  location          String?
  interviewerUserId String?
  interviewerUser   User?            @relation("InterviewInterviewer", fields: [interviewerUserId], references: [id])
  interviewerName   String? // nome exibido (ex.: "Sara / Aline" vindo da planilha)
  status            InterviewStatus  @default(AGENDADA)
  result            InterviewResult  @default(PENDENTE)
  reasonId          String?
  reason            RejectionReason? @relation(fields: [reasonId], references: [id])
  resultNote        String?          @db.Text
  resultAt          DateTime?
  resultById        String?
  resultBy          User?            @relation("InterviewResultBy", fields: [resultById], references: [id])
  score             Float?
  notes             String?          @db.Text
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([applicationId])
  @@index([scheduledAt])
  @@index([result])
}

enum ManagerDecision {
  PENDENTE
  APROVADO
  REPROVADO
  NOVA_ENTREVISTA
}

/// Avaliação do gestor — criada automaticamente quando o RH aprova. Separada do resultado do RH.
model ManagerReview {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id])
  managerId     String?
  manager       Manager?         @relation(fields: [managerId], references: [id])
  status        ManagerDecision  @default(PENDENTE)
  reasonId      String?
  reason        RejectionReason? @relation(fields: [reasonId], references: [id])
  justification String?          @db.Text
  onBehalf      Boolean          @default(false) // registrado pelo RH em nome do gestor
  requestedById String?
  requestedBy   User?            @relation("ReviewRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?            @relation("ReviewDecidedBy", fields: [decidedById], references: [id])
  requestedAt   DateTime         @default(now())
  decidedAt     DateTime?

  @@index([managerId, status])
  @@index([applicationId])
}

enum CandidateEventType {
  CADASTRO
  EDICAO
  CANDIDATURA
  ENTREVISTA_AGENDADA
  ENTREVISTA_REMARCADA
  ENTREVISTA_CANCELADA
  RESULTADO_RH
  AVALIACAO_EXTERNA
  ENCAMINHADO_GESTOR
  DECISAO_GESTOR
  STATUS
  SALARIO
  IMPORTACAO
  OBSERVACAO
}

/// Histórico do candidato — somente inserção (trigger no banco).
model CandidateEvent {
  id            String             @id @default(cuid())
  candidateId   String
  candidate     Candidate          @relation(fields: [candidateId], references: [id])
  applicationId String?
  application   Application?       @relation(fields: [applicationId], references: [id])
  interviewId   String?
  type          CandidateEventType
  summary       String
  details       Json?
  actorUserId   String?
  actorUser     User?              @relation("CandidateEventActor", fields: [actorUserId], references: [id])
  actorName     String? // quem decidiu (texto, para registros importados)
  occurredAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())

  @@index([candidateId, occurredAt])
}

// ───────────────────────── IMPORTAÇÃO DA PLANILHA ─────────────────────────

enum ImportBatchStatus {
  CARREGADO
  ANALISADO
  IMPORTADO
  CANCELADO
}

enum ImportRowStatus {
  OK
  ALERTA // importável, com observação (ex.: sem telefone)
  DUPLICADO_ARQUIVO
  JA_EXISTE
  INCONSISTENTE
  IMPORTADO
  IGNORADO
}

model ImportBatch {
  id           String            @id @default(cuid())
  fileName     String
  sha256       String
  sheetName    String?
  status       ImportBatchStatus @default(CARREGADO)
  headers      Json // cabeçalhos da planilha
  columnMap    Json? // coluna da planilha → campo
  valueMap     Json? // valor da planilha → cadastro (unidade, cargo, resultado, motivo…)
  summary      Json?
  totalRows    Int               @default(0)
  importedRows Int               @default(0)
  ignoredRows  Int               @default(0)
  createdById  String
  createdBy    User              @relation("ImportCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  committedAt  DateTime?

  rows ImportRow[]
}

model ImportRow {
  id           String          @id @default(cuid())
  batchId      String
  batch        ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber    Int // linha na planilha original
  raw          Json
  normalized   Json?
  status       ImportRowStatus @default(OK)
  issues       String[]        @default([])
  decision     String? // IMPORTAR | IGNORAR | VINCULAR
  ignoreReason String?
  candidateId  String?

  @@index([batchId, status])
}

// ───────────────────────── NOTIFICAÇÕES / CONFIGURAÇÕES / DOCUMENTOS ─────────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDENTE // na fila (inclui "aguardando configuração do e-mail" e novas tentativas)
  ENVIANDO // em envio (trava contra envio duplicado)
  ENVIADA
  FALHOU // esgotou as tentativas
  LIDA
  CANCELADA
}

/// Fila de e-mails (outbox) com novas tentativas e histórico. O envio real é feito pelo
/// provedor configurado (SMTP corporativo ou Resend). Sem configuração, a mensagem fica
/// PENDENTE — nunca é dada como enviada sem o provedor confirmar.
model Notification {
  id              String              @id @default(cuid())
  channel         NotificationChannel
  status          NotificationStatus  @default(PENDENTE)
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id])
  recipientEmail  String?
  template        String // ex.: "auth.password_reset"
  subject         String
  body            String              @db.Text
  relatedEntity   String?
  relatedId       String?
  scheduledFor    DateTime            @default(now())
  sentAt          DateTime?
  readAt          DateTime?
  error           String? // último erro do provedor
  htmlBody        String?             @db.Text
  cc              String[]            @default([])
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(6)
  nextAttemptAt   DateTime            @default(now())
  lockedAt        DateTime?
  providerId      String? // id da mensagem no provedor (SMTP/Resend)
  digestId        String?             @unique
  digest          ManagerDigest?      @relation(fields: [digestId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([status, nextAttemptAt])
  @@index([recipientUserId])
}

model Setting {
  key         String   @id // ex.: "security.session_hours"
  value       Json
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum DocumentClassification {
  INTERNO
  CONFIDENCIAL
  SENSIVEL // dados pessoais sensíveis (LGPD art. 5º, II)
}

/// Metadados de documentos. O arquivo fica fora da pasta pública, cifrado (AES-256-GCM),
/// e só é servido pela API após checagem de permissão + registro de auditoria.
model Document {
  id             String                 @id @default(cuid())
  ownerType      String // "Employee" | "Candidate" | "Manager" ...
  ownerId        String
  category       String // ex.: "contrato", "curriculo", "aso"
  originalName   String
  mimeType       String
  sizeBytes      Int
  sha256         String
  storageKey     String                 @unique // legado/identificador; conteúdo em DocumentBlob
  classification DocumentClassification @default(CONFIDENCIAL)
  uploadedById   String
  uploadedBy     User                   @relation(fields: [uploadedById], references: [id])
  blob           DocumentBlob?
  deletedAt      DateTime?
  createdAt      DateTime               @default(now())

  @@index([ownerType, ownerId])
}

/// Conteúdo do documento, cifrado (AES-256-GCM: iv|tag|dados). Fica no banco porque o
/// sistema de arquivos de ambientes serverless (Vercel) é efêmero; entra no backup do banco.
model DocumentBlob {
  documentId String   @id
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  data       Bytes
}

// ───────────────────────── COMUNICAÇÃO COM GESTORES (Fase 3) ─────────────────────────

enum DigestType {
  AGENDA // aviso consolidado de entrevistas agendadas (por gestor e data)
  FECHAMENTO // relatório do fim do dia (por gestor e data)
}

enum DigestStatus {
  PENDENTE // aguardando a janela de consolidação
  AGUARDANDO_REVISAO // o RH pediu para revisar o texto antes do envio
  EMITIDO // mensagem gerada e colocada na fila de envio
  DESCARTADO // nada mudou desde o último envio, ou o RH optou por não enviar
  SEM_DESTINATARIO // vaga sem gestor/e-mail — exige ação do RH
}

/// Comunicação consolidada por (tipo, gestor, data, versão). Versão > 1 = atualização/retificação.
/// `snapshotHash` impede reenviar o mesmo conteúdo.
model ManagerDigest {
  id              String       @id @default(cuid())
  type            DigestType
  managerId       String
  manager         Manager      @relation(fields: [managerId], references: [id])
  date            String // AAAA-MM-DD (fuso America/Sao_Paulo)
  version         Int          @default(1)
  status          DigestStatus @default(PENDENTE)
  isRectification Boolean      @default(false)
  hold            Boolean      @default(false) // aguardar revisão do RH
  scheduledFor    DateTime     @default(now())
  subject         String?
  bodyText        String?      @db.Text
  customSubject   String?
  customBody      String?      @db.Text
  customForHash   String? // hash da agenda quando o texto foi editado
  editedById      String?
  editedAt        DateTime?
  snapshot        Json?
  snapshotHash    String?
  note            String? // ex.: "texto editado descartado: a agenda mudou"
  emittedAt       DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  notification Notification?

  @@unique([type, managerId, date, version])
  @@index([status, scheduledFor])
  @@index([date])
}

/// Fechamento da agenda de um dia (manual pelo RH ou automático no horário configurado).
model DailyClosing {
  date         String   @id // AAAA-MM-DD
  mode         String // MANUAL | AUTOMATICO
  closedAt     DateTime @default(now())
  closedById   String?
  pendingCount Int      @default(0) // entrevistas sem resultado no momento do fechamento
  summary      Json?
}

/// Trava simples para tarefas periódicas (evita dois processamentos simultâneos).
model SystemLock {
  name        String   @id
  lockedUntil DateTime
}

// ───────────────────────── AUDITORIA (somente inserção) ─────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  REOPEN
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET
  PASSWORD_CHANGE
  PII_ACCESS
  DOCUMENT_UPLOAD
  DOCUMENT_DOWNLOAD
  PERMISSION_CHANGE
  ACCESS_DENIED
  EXPORT
}

model AuditLog {
  id                 String      @id @default(cuid())
  entityType         String
  entityId           String?
  action             AuditAction
  actorId            String?
  actor              User?       @relation("ActorUser", fields: [actorId], references: [id])
  actorRole          Role?
  impactedEmployeeId String?
  impactedEmployee   Employee?   @relation("ImpactedEmployee", fields: [impactedEmployeeId], references: [id])
  previousValue      Json?
  newValue           Json?
  justification      String?     @db.Text
  ip                 String?
  userAgent          String?
  createdAt          DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ───────────────────────── ONBOARDING / CARREIRA / PDI (preservados do MVP) ─────────────────────────

enum StageOwner {
  RH
  GESTOR
  BUDDY
}

// Pesos de promoção (RH-CAR-01): Performance 25%, Competência 20%, Comportamento 15%,
// Aderência cultural 10%, Potencial de liderança 10%, PDI 10%, Conduta 10%. Mínimo 70/100.
model PromotionScore {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id])
  cycle               String
  performance         Float    @default(0)
  competency          Float    @default(0)
  behavior            Float    @default(0)
  culturalFit         Float    @default(0)
  leadershipPotential Float    @default(0)
  pdiCompletion       Float    @default(0)
  conduct             Float    @default(0)
  totalScore          Float    @default(0)
  committeeRequired   Boolean  @default(false)
  committeeMinutes    String?  @db.Text
  decision            String?
  createdAt           DateTime @default(now())

  @@index([employeeId])
}

model BuddyEligibility {
  id               String    @id @default(cuid())
  employeeId       String    @unique
  lastEvaluation   Float
  monthsOfTenure   Int
  disciplinaryFree Boolean
  voluntaryOptIn   Boolean
  approved         Boolean   @default(false)
  approvedAt       DateTime?
}

// ───────────────────────── TEMPLATES (oficiais, somente RH/ADMIN editam) ─────────────────────────

enum OnboardingPeriod {
  PERIODO_1 // Dias -7 a 45: adaptação, desenvolvimento e padronização
  PERIODO_2 // Dias 46 a 90: produtividade, autonomia e performance
}

model OnboardingTemplate {
  id         String    @id @default(cuid())
  name       String
  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])
  active     Boolean   @default(true)
  version    String    @default("v01/2026")
  createdAt  DateTime  @default(now())

  stages    OnboardingStageTemplate[]
  processes OnboardingProcess[]
}

model OnboardingStageTemplate {
  // As 8 etapas operacionais do RH-ONB-02
  id            String             @id @default(cuid())
  templateId    String
  template      OnboardingTemplate @relation(fields: [templateId], references: [id])
  period        OnboardingPeriod
  name          String // ex.: "Etapa 2 — Imersão"
  dayRangeStart Int // dia relativo à admissão (pode ser negativo para pré-admissão)
  dayRangeEnd   Int
  owner         StageOwner // dono padrão da etapa
  order         Int

  checklistItemTemplates ChecklistItemTemplate[]
}

enum ChecklistItemType {
  DOCUMENT_SIGNATURE
  TRAINING
  MEETING
  EVALUATION
  TASK
  SURVEY
}

model ChecklistItemTemplate {
  id              String                  @id @default(cuid())
  stageTemplateId String
  stageTemplate   OnboardingStageTemplate @relation(fields: [stageTemplateId], references: [id])
  title           String
  description     String?                 @db.Text
  type            ChecklistItemType
  dueDayOffset    Int // dias após admissão
  order           Int
}

// ───────────────────────── PROCESSO DE ONBOARDING (instância real) ─────────────────────────

enum OnboardingStatus {
  ATIVO
  CONCLUIDO
  ENCERRADO_PERIODO_EXPERIENCIA
  ESTENDIDO
}

model OnboardingProcess {
  id            String             @id @default(cuid())
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id])
  templateId    String
  template      OnboardingTemplate @relation(fields: [templateId], references: [id])
  startDate     DateTime
  status        OnboardingStatus   @default(ATIVO)
  extendedUntil DateTime? // período estendido de experiência (+30 dias, RH-SOP-01 Script 02)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  stages      OnboardingStage[]
  evaluations Evaluation[]
  pdis        PDI[]

  @@index([employeeId])
}

enum StageStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ATRASADA
  REABERTA
}

model OnboardingStage {
  id             String            @id @default(cuid())
  processId      String
  process        OnboardingProcess @relation(fields: [processId], references: [id])
  name           String
  period         OnboardingPeriod
  dueDate        DateTime?
  completedDate  DateTime?
  status         StageStatus       @default(PENDENTE)
  responsibleId  String?
  responsible    Employee?         @relation(fields: [responsibleId], references: [id])
  reopenedReason String?           @db.Text
  order          Int

  checklistItems ChecklistItem[]

  @@index([processId])
}

// ───────────────────────── CHECKLIST (compartilhado entre Onboarding, Carreira e PDI) ─────────────────────────

enum ChecklistOrigin {
  ONBOARDING
  CAREER_TRACK
  PDI
  PDL
}

enum ChecklistStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
  CANCELADO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

model ChecklistItem {
  id                String            @id @default(cuid())
  title             String
  description       String?           @db.Text
  type              ChecklistItemType
  origin            ChecklistOrigin
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id])
  onboardingStageId String?
  onboardingStage   OnboardingStage?  @relation(fields: [onboardingStageId], references: [id])
  pdiId             String?
  pdi               PDI?              @relation(fields: [pdiId], references: [id])
  responsibleId     String?
  responsible       Employee?         @relation("ChecklistResponsible", fields: [responsibleId], references: [id])
  dueDate           DateTime?
  completedDate     DateTime?
  status            ChecklistStatus   @default(PENDENTE)
  priority          Priority          @default(MEDIA)
  observation       String?           @db.Text
  justification     String?           @db.Text
  evidenceUrl       String?
  completedById     String?
  completedBy       Employee?         @relation("ChecklistCompletedBy", fields: [completedById], references: [id])
  validatedById     String?
  validatedBy       Employee?         @relation("ChecklistValidatedBy", fields: [validatedById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ───────────────────────── AVALIAÇÕES ─────────────────────────

enum EvaluationMilestone {
  D45
  D90
  CICLO_SEMESTRAL
  PDL_360
}

// Pesos fixos D45/D90 conforme RH-ONB-01: Metas 35%, Domínio técnico 25%, POPs 20%, Presença/conduta 15%, Integração 5%
model Evaluation {
  id                  String              @id @default(cuid())
  processId           String?
  process             OnboardingProcess?  @relation(fields: [processId], references: [id])
  employeeId          String
  milestone           EvaluationMilestone
  goalsScore          Float? // 35%
  technicalScore      Float? // 25%
  popsScore           Float? // 20%
  attendanceScore     Float? // 15%
  teamworkScore       Float? // 5%
  finalScore          Float?
  belowAlertThreshold Boolean             @default(false) // nota < 5,5 dispara alerta (RH-ONB-02)
  evaluatorId         String
  evaluator           Employee            @relation(fields: [evaluatorId], references: [id])
  outcome             String? // aprovado / aprovado com PDI / extensão / encerramento
  notes               String?             @db.Text
  createdAt           DateTime            @default(now())

  @@index([employeeId])
}

// Pesquisa de bem-estar (Dias 7/15/30/45) — RH-ONB-02
model WellbeingCheck {
  id              String    @id @default(cuid())
  employeeId      String
  dayOffset       Int // 7, 15, 30, 45
  q1Support       Int? // 1-5
  q2Clarity       Int? // 1-5
  q3Future        String? // Sim / Não sei / Não
  alertTriggered  Boolean   @default(false)
  alertResolvedAt DateTime?
  createdAt       DateTime  @default(now())

  @@index([employeeId])
}

// ───────────────────────── PDI / PLANO DE MELHORIA ─────────────────────────

enum PDIOrigin {
  AVALIACAO_ONBOARDING
  AVALIACAO_EXPERIENCIA
  FEEDBACK_GESTOR
  PLANO_CARREIRA
  GAP_RH
  SOLIDES_IMPORT
  PDL
}

enum PDIStatus {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model PDI {
  id                  String             @id @default(cuid())
  employeeId          String
  employee            Employee           @relation(fields: [employeeId], references: [id])
  onboardingProcessId String?
  onboardingProcess   OnboardingProcess? @relation(fields: [onboardingProcessId], references: [id])
  origin              PDIOrigin
  gapDescription      String             @db.Text
  developmentGoal     String             @db.Text
  recommendedAction   String             @db.Text
  executorId          String? // responsável pela execução
  executor            Employee?          @relation("PDIExecutor", fields: [executorId], references: [id])
  monitorId           String? // responsável pelo acompanhamento
  monitor             Employee?          @relation("PDIMonitor", fields: [monitorId], references: [id])
  dueDate             DateTime?
  status              PDIStatus          @default(ABERTO)
  evidenceUrl         String?
  checkpointNotes     String?            @db.Text
  finalOpinion        String?            @db.Text
  completionPct       Float              @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  checklistItems ChecklistItem[]

  @@index([employeeId])
}

// ───────────────────────── PDL — PROGRAMA DE DESENVOLVIMENTO DE LIDERANÇAS ─────────────────────────

enum PDLStage {
  DIAGNOSTICO
  FORMACAO
  IMERSAO
  AVALIACAO_FINAL
  TRANSICAO
}

enum PDLStatus {
  CANDIDATO
  EM_ANDAMENTO
  CONCLUIDO
  REPROVADO
  CANCELADO
}

// Critérios de entrada RH-PDL-01: avaliação >= 8.0 (2 ciclos), 18+ meses de casa,
// zero advertências em 12 meses, PDI >= 80% conclusão, indicação do gestor, aceite voluntário
model PDLCandidacy {
  id                     String    @id @default(cuid())
  employeeId             String
  employee               Employee  @relation(fields: [employeeId], references: [id])
  targetPositionId       String?
  targetPosition         Position? @relation(fields: [targetPositionId], references: [id])
  stage                  PDLStage  @default(DIAGNOSTICO)
  status                 PDLStatus @default(CANDIDATO)
  evaluationLast2Cycles  Float?
  tenureMonths           Int?
  disciplinaryFree12m    Boolean?
  pdiCompletionLastCycle Float?
  managerJustification   String?   @db.Text
  voluntaryOptIn         Boolean   @default(false)
  evaluation360Score     Float?
  committeeDecision      String?   @db.Text
  startedAt              DateTime  @default(now())
  finishedAt             DateTime?

  @@index([employeeId])
}
