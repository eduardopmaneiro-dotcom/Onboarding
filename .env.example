# ═══ Banco de dados (PostgreSQL / Neon) ═══
# Local: as duas URLs podem ser iguais.
# Neon (integração Vercel): preenchidas automaticamente — DATABASE_URL usa o pooler,
# DATABASE_URL_UNPOOLED é a conexão direta usada pelas migrações.
DATABASE_URL="postgresql://riale:riale_dev@localhost:5432/riale_rh?schema=public"
DATABASE_URL_UNPOOLED="postgresql://riale:riale_dev@localhost:5432/riale_rh?schema=public"

# ═══ Sessão (NextAuth) — gere com: openssl rand -base64 32 ═══
AUTH_SECRET="troque-este-valor"
AUTH_TRUST_HOST=true
# Opcional na Vercel (usa o domínio de produção automaticamente). Ex.: https://rh.rialehoteis.com.br
APP_URL="http://localhost:3000"

# ═══ Proteção de dados pessoais (LGPD) — NUNCA altere depois de entrar em produção ═══
# Gere cada uma com: openssl rand -base64 32
CPF_HASH_PEPPER="troque-este-valor"
DATA_ENCRYPTION_KEY="troque-este-valor"

# ═══ Primeiro acesso (cria o 1º administrador em /primeiro-acesso) ═══
# Funciona só enquanto não existir nenhum usuário. Depois pode ser removido.
BOOTSTRAP_ADMIN_CPF=""
# Código secreto (mín. 16 caracteres) que será pedido na tela. Gere com: openssl rand -base64 18
BOOTSTRAP_TOKEN=""

# ═══ E-mail (Fase 3 — comunicação com gestores). Sem isto, as mensagens ficam na fila ═══
# Ver docs/COMUNICACAO.md. Provedor: smtp (e-mail corporativo) ou resend.
EMAIL_PROVIDER=""
EMAIL_FROM="Recursos Humanos — Riale Hotéis <rh@rialehoteis.com.br>"
EMAIL_REPLY_TO=""
# Google Workspace: smtp.gmail.com / 465 / true · Microsoft 365: smtp.office365.com / 587 / false
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Alternativa por API
RESEND_API_KEY=""
# Protege /api/cron/tick (fechamento automático). Gere com: openssl rand -base64 32
CRON_SECRET=""

# ═══ Backups locais (npm run db:backup) ═══
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30
BACKUP_GPG_RECIPIENT=""
