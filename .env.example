# ─── Banco de dados (PostgreSQL 14+) ───
DATABASE_URL="postgresql://riale:riale_dev@localhost:5432/riale_rh?schema=public"

# ─── Sessão (NextAuth) — gere com: openssl rand -base64 32 ───
AUTH_SECRET="troque-este-valor"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# ─── Proteção de dados pessoais (LGPD) ───
# Pepper do HMAC do CPF (busca/unicidade). NUNCA altere após entrar em produção
# sem rodar a rotina de re-hash. Gere com: openssl rand -base64 32
CPF_HASH_PEPPER="troque-este-valor"
# Chave AES-256-GCM (32 bytes em base64) para CPF e documentos. Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY="troque-este-valor"

# ─── Armazenamento de documentos (fora de /public) ───
DOCUMENTS_DIR="./storage/documents"

# ─── Backups ───
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30
# Opcional: destinatário GPG para cifrar os dumps (recomendado em produção)
BACKUP_GPG_RECIPIENT=""
