{
  "name": "riale-rh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src prisma tests scripts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "bash scripts/backup.sh",
    "db:restore": "bash scripts/restore.sh",
    "test": "tsx --env-file=.env --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "postinstall": "prisma generate",
    "db:seed:demo": "SEED_DEMO=true tsx prisma/seed.ts",
    "vercel-build": "tsx scripts/check-env.ts && prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "test:e2e:first-access": "node tests/e2e/first-access.cjs",
    "test:e2e:recrutamento": "node tests/e2e/recruitment.mjs",
    "test:e2e:comunicacao": "node tests/e2e/comms.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.5.3",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "mailparser": "^3.7.2",
    "smtp-server": "^3.13.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
